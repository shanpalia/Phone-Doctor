<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PhoneDoctor" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#05B879</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#F4FFFB</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowSplashScreenBackground">#F7FFFB</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_phone_doctor</item>
        <item name="android:windowSplashScreenBrandingImage">@drawable/ic_phone_doctor</item>
        <item name="android:postSplashScreenTheme">@style/Theme.PhoneDoctor</item>
    </style>
</resources>
